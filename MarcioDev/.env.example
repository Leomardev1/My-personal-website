# Definições para desenvolvimento local.
# Copia este ficheiro para ".env" (na mesma pasta); o ".env" não vai para o git.
DEBUG=True

# Em produção NÃO se usa este ficheiro: as variáveis definem-se no painel do Render.
#   SECRET_KEY    obrigatória; valor longo e aleatório
#   DATABASE_URL  ligação ao PostgreSQL (sem ela usa-se SQLite, que o Render apaga)
#   SITE_HOST     opcional; só com domínio próprio (ex.: meusite.com)
